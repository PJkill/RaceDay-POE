@model IEnumerable<RaceDay.MVC.Controllers.EnrolmentViewModel>
@{
    ViewData["Title"] = "My Enrolments";
}

<h2 class="mt-4 mb-4">My Enrolments</h2>

@if (!Model.Any())
{
    <div class="alert alert-info">
        You haven't enrolled in any events yet. <a asp-controller="Home" asp-action="Index">Browse Events</a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover shadow-sm">
            <thead class="table-primary">
                <tr>
                    <th>Event Name</th>
                    <th>Category</th>
                    <th>Date Enrolled</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Category?.Event?.Name</td>
                        <td>@item.Category?.Name</td>
                        <td>@item.EnrolmentDate.ToString("dd MMM yyyy HH:mm")</td>
                        <td>
                            @if (item.Status == "Confirmed")
                            {
                                <span class="badge bg-success">Confirmed</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">@item.Status</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}