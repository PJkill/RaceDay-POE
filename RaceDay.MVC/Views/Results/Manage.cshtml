@model RaceDay.MVC.Controllers.ManageResultsViewModel
@{
    ViewData["Title"] = "Manage Results - " + Model.EventName;
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-4">
    <h2>Results for: <span class="text-primary">@Model.EventName</span></h2>
    <a asp-controller="Organiser" asp-action="Dashboard" class="btn btn-outline-secondary">Back to Dashboard</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="card shadow">
    <div class="card-body">
        @if (!Model.Enrolments.Any())
        {
            <p class="text-muted">No participants have enrolled in this event yet.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-bordered align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Participant</th>
                            <th>Category</th>
                            <th>Status</th>
                            <th>Finish Time (hh:mm:ss)</th>
                            <th>Position</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Enrolments)
                        {
                            <tr>
                                <td>
                                    <strong>@item.Participant?.User?.FullName</strong><br />
                                    <small class="text-muted">@item.Participant?.User?.Email</small>
                                </td>
                                <td>@item.Category?.Name</td>
                                <td>
                                    @if (item.Result != null)
                                    {
                                        <span class="badge bg-success">Result Recorded</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">@item.Status</span>
                                    }
                                </td>

                                <!-- Form to submit result -->
                                <form asp-action="SubmitResult" method="post">
                                    <input type="hidden" name="enrolmentId" value="@item.EnrolmentId" />
                                    <input type="hidden" name="eventId" value="@Model.EventId" />

                                <td>
                                    @if (item.Result != null)
                                    {
                                        <input type="text" class="form-control" value="@item.Result.FinishTime" readonly />
                                    }
                                    else
                                    {
                                        <input type="text" name="finishTime" class="form-control" placeholder="02:30:00" required />
                                    }
                                </td>
                                <td>
                                    @if (item.Result != null)
                                    {
                                        <input type="number" class="form-control" value="@item.Result.Position" readonly />
                                    }
                                    else
                                    {
                                        <input type="number" name="position" class="form-control" placeholder="e.g. 15" required />
                                    }
                                </td>
                                <td>
                                    @if (item.Result == null)
                                    {
                                        <button type="submit" class="btn btn-primary btn-sm w-100">Save Result</button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-secondary btn-sm w-100" disabled>Saved</button>
                                    }
                                </td>
                                </form>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>