@model IEnumerable<RaceDay.MVC.Models.EventViewModel>
@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-4">
    <h2>Organiser Dashboard</h2>
    <a asp-action="CreateEvent" class="btn btn-primary">+ Create New Event</a>
</div>

<div class="row">
    @if (!Model.Any())
    {
        <div class="col-12">
            <div class="alert alert-info">You haven't created any events yet.</div>
        </div>
    }
    else
    {
        foreach (var ev in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h5 class="card-title">@ev.Name</h5>
                        <h6 class="card-subtitle mb-2 text-muted">@ev.EventType | @ev.Distance</h6>
                        <p class="card-text">@ev.Description</p>
                        <ul class="list-unstyled">
                            <li><strong>Date:</strong> @ev.Date.ToString("dd MMM yyyy")</li>
                            <li><strong>Location:</strong> @ev.Location</li>
                            <li><strong>Status:</strong> <span class="badge bg-success">@ev.Status</span></li>
                        </ul>
                    </div>
                    <div class="card-footer bg-white border-top-0 pb-3">
                        <a asp-controller="Results" asp-action="Manage" asp-route-eventId="@ev.EventId" class="btn btn-outline-success w-100">
                            Manage Enrolments & Results
                        </a>
                    </div>
                </div>
            </div>
        }
    }
</div>